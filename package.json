{
  "name": "pi-persistent-session",
  "version": "0.2.1",
  "description": "Move Pi session files when a workspace directory moves",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi-extension",
    "sessions"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "files": [
    "index.ts",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "test": "node --test"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.0",
    "@types/node": "24.12.4",
    "typebox": "1.3.7",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
